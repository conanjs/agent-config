{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/conanjs/agent-config/contracts/slots/v1/schema.json",
  "title": "slots/v1",
  "description": "The sockets components fill (contracts/slots.yaml). Unknown keys are tolerated; the old keys count and mounts are refused (AC-1.3).",
  "type": "object",
  "properties": {
    "schema": {
      "const": "slots/v1"
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slot"
      }
    }
  },
  "required": ["schema", "slots"],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "M-03: lowercase letters, digits and hyphens, 1 to 64 characters, starting with a letter or digit."
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?:(?:\\.|[^/\\\\:\\u0000]*[^/\\\\:\\u0000. ])?/)*(?:\\.|[^/\\\\:\\u0000]*[^/\\\\:\\u0000. ])?$",
      "description": "M-03: relative, no .. segment, drive letter, colon, backslash or NUL, no segment ending in a dot or space."
    },
    "contractName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*/v[1-9][0-9]*$",
      "description": "A contract id such as component/v1."
    },
    "scope": {
      "enum": ["global", "per-project"]
    },
    "location": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/id"
        },
        "mount": {
          "$ref": "#/$defs/path"
        },
        "required": {
          "type": "boolean"
        },
        "shared": {
          "type": "boolean"
        },
        "index": {
          "enum": ["provided", "generated"]
        }
      },
      "required": ["name", "mount"]
    },
    "slot": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/id"
        },
        "reserved": {
          "type": "boolean"
        },
        "contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/contractName"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/contractName"
              }
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "multiple": {
          "type": "boolean"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "self-contained": {
          "type": "boolean"
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "count": false,
        "mounts": false
      },
      "required": ["name", "contract", "required", "multiple", "scope", "locations"]
    }
  }
}
