{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/conanjs/agent-config/blob/main/copilot/frameworks/agentic-sdlc/tools/workflow-graph/interfaces/schemas/workflow-graph.schema.json",
  "title": "Workflow graph (workflow-graph/v1)",
  "description": "The shape of workflow.graph.yaml (source) and workflow.graph.json (generated by compile-graph). The rules (WG-1 … WG-14: reachable nodes, gates with approved and changes-requested edges, budgets on loops …) are in schemas/workflow-graph.schema.md and checked by check-graph; this schema checks only the shape. Public, production (graph 2.0.0). Editors can use it: # yaml-language-server: $schema=<this file>.",
  "type": "object",
  "required": [
    "schema",
    "name",
    "version",
    "start",
    "nodes",
    "edges",
    "paths"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "workflow-graph/v1"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "start": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9.-]*$"
    },
    "budgets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "default",
          "loop",
          "exhausted"
        ],
        "additionalProperties": false,
        "properties": {
          "default": {
            "type": "integer",
            "minimum": 0
          },
          "loop": {
            "type": "string"
          },
          "exhausted": {
            "type": "string"
          }
        }
      }
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9.-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/path"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "phase",
            "gate",
            "step",
            "end"
          ]
        },
        "title": {
          "type": "string"
        },
        "owner": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gate": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9.-]*$"
        },
        "runs-when": {
          "type": "string"
        },
        "owners-text": {
          "type": "string"
        },
        "speckit": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "gate-text": {
          "type": "string"
        },
        "launches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "mode"
            ],
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string"
              },
              "mode": {
                "enum": [
                  "propose",
                  "decide",
                  "execute",
                  "review"
                ]
              }
            }
          }
        },
        "join": {
          "const": "all-tasks"
        },
        "of": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9.-]*$"
        },
        "mode": {
          "enum": [
            "propose",
            "decide",
            "execute",
            "review"
          ]
        },
        "executor": {
          "const": "script"
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "to",
        "on"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9.-]*$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9.-]*$"
        },
        "on": {
          "type": "string",
          "description": "The from-node's result that takes this edge; otherwise = any other result"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budget": {
          "type": "string",
          "description": "A key of budgets"
        }
      }
    },
    "path": {
      "type": "object",
      "required": [
        "id",
        "when",
        "run"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "when": {
          "type": "string"
        },
        "run": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9.-]*$"
          }
        },
        "path-text": {
          "type": "string"
        }
      }
    }
  }
}
