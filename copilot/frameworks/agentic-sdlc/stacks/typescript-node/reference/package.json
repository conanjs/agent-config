{
  "name": "typescript-node-reference",
  "version": "0.0.0",
  "private": true,
  "description": "Reference architecture for the agentic-sdlc typescript-node stack: one feature through every layer.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "format": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "smoke": "pnpm run build && node scripts/smoke-aliases.mjs",
    "check": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:integration && pnpm run smoke"
  },
  "dependencies": {
    "express": "~5.3.0",
    "pino": "~10.4.0",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "prettier": "^3.9.10",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "5.0.5"
  }
}
