{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/conanjs/agent-config/contracts/rendered-copy/v1/schema.json",
  "title": "rendered-copy/v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rendered-copy/v1"
    },
    "system": {
      "enum": ["mac", "linux", "windows"]
    },
    "copy": {
      "type": "string",
      "pattern": "^(?!/)(?![\\s\\S]*[\\\\:\\u0000])(?![\\s\\S]*(?:^|/)\\.\\.(?:/|$))(?![\\s\\S]*(?:[^/][. ]|(?:^|/) )(?:/|$))generated/[a-z0-9][a-z0-9-]{0,63}/[\\s\\S]+$"
    },
    "first-line": {
      "const": "Generated from `<source path>`; edit that file, not this copy."
    },
    "mode": {
      "enum": ["read-only"]
    },
    "index": {
      "const": "{{AGENT_HOME}}/generated/index.md"
    },
    "refresh": {
      "type": "object",
      "properties": {
        "on": {
          "type": "array",
          "items": {
            "enum": ["install", "install --update", "session-start"]
          },
          "minItems": 1
        },
        "session-start": {
          "type": "object",
          "properties": {
            "only-changed": {
              "type": "boolean"
            },
            "time-limit-seconds": {
              "type": "integer",
              "minimum": 1
            },
            "network": {
              "enum": ["none"]
            },
            "on-failure": {
              "enum": ["keep-previous-print-one-line-exit-0"]
            }
          },
          "required": ["only-changed", "time-limit-seconds", "network", "on-failure"]
        }
      },
      "required": ["on", "session-start"]
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "pattern": "^(?:/|[A-Za-z]:\\\\)[\\s\\S]+$"
          },
          "target": {
            "type": "string",
            "pattern": "^(?!/)(?![\\s\\S]*[\\\\:\\s\\u0000])[\\s\\S]+$"
          }
        },
        "required": ["text", "target"]
      }
    }
  },
  "required": ["schema", "system", "copy", "first-line", "mode", "index", "refresh", "citations"]
}
