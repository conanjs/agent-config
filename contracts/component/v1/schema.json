{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/conanjs/agent-config/contracts/component/v1/schema.json",
  "title": "component/v1",
  "description": "The manifest every component publishes as component.yaml. Unknown keys are tolerated (CON-10).",
  "type": "object",
  "properties": {
    "schema": {
      "const": "component/v1"
    },
    "name": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "slot": {
      "$ref": "#/$defs/id"
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9-]{0,38}/(?!\\.*(?:\\.git)?$)[A-Za-z0-9._-]{1,100}$",
      "description": "CM-4, A-23, M-07: https://github.com/<owner>/<repository>, no user-info."
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "contracts": {
      "type": "object",
      "properties": {
        "pin": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["pin"]
    },
    "locations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/path"
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      }
    },
    "provides": {
      "$ref": "#/$defs/provides"
    },
    "depends": {
      "type": "object",
      "properties": {
        "slots": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/slotDependency"
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": []
    },
    "routes": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "hooks": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/hook"
      }
    },
    "variables": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/variable"
      }
    },
    "idle-cost": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "required": ["schema", "name", "version", "slot", "contracts", "locations"],
  "if": {
    "type": "object",
    "properties": {
      "provides": {
        "type": "object",
        "properties": {
          "exports": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": ["exports"]
      }
    },
    "required": ["provides"]
  },
  "then": {
    "properties": {
      "repository": {}
    },
    "required": ["repository"]
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "M-03: lowercase letters, digits and hyphens, 1 to 64 characters, starting with a letter or digit."
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?:(?:\\.|[^/\\\\:\\u0000]*[^/\\\\:\\u0000. ])?/)*(?:\\.|[^/\\\\:\\u0000]*[^/\\\\:\\u0000. ])?$",
      "description": "M-03: relative, no .. segment, drive letter, colon, backslash or NUL, no segment ending in a dot or space."
    },
    "contractName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*/v[1-9][0-9]*$",
      "description": "A contract id such as component/v1."
    },
    "scope": {
      "enum": ["global", "per-project"]
    },
    "refName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.][A-Za-z0-9_./+@-]*$",
      "description": "M-05: a branch or tag name that cannot start with a dash."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSource": {
      "type": "object",
      "properties": {
        "type": {
          "const": "git"
        },
        "url": {
          "type": "string",
          "anyOf": [
            {
              "pattern": "^https://(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|(?!(?:[a-z0-9.-]*\\.)?(?:[0-9]+|0x[0-9a-f]*)(?::|/|$))[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?)(?!:443(?:/|$))(?::(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._~!$&'()*+,;=:@|-]*)*$"
            },
            {
              "pattern": "^ssh://(?:[A-Za-z0-9._-]+@)?[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._~!$&'()*+,;=:@|-]*)*$"
            }
          ],
          "description": "CL-3, CL-4, M-05, M-07: https or ssh, no password, no user-info on https, no query or fragment."
        },
        "ref": {
          "$ref": "#/$defs/refName"
        }
      },
      "required": ["type", "url", "ref"]
    },
    "archiveSource": {
      "type": "object",
      "properties": {
        "type": {
          "const": "archive"
        },
        "url": {
          "type": "string",
          "pattern": "^https://(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|(?!(?:[a-z0-9.-]*\\.)?(?:[0-9]+|0x[0-9a-f]*)(?::|/|$))[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?)(?!:443(?:/|$))(?::(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._~!$&'()*+,;=:@|-]*)*$",
          "description": "https only; archive sources are recognised and refused in this release (AC-3.7)."
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": ["type", "url", "sha256"]
    },
    "service": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "mcp"
        },
        "name": {
          "$ref": "#/$defs/id"
        },
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["kind", "name", "command"]
    },
    "slotDependency": {
      "type": "object",
      "properties": {
        "slot": {
          "$ref": "#/$defs/id"
        },
        "contract": {
          "$ref": "#/$defs/contractName"
        },
        "required": {
          "type": "boolean"
        },
        "docs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "suggest": {
          "type": "object",
          "properties": {
            "source": {
              "oneOf": [
                {
                  "$ref": "#/$defs/gitSource"
                },
                {
                  "$ref": "#/$defs/archiveSource"
                }
              ]
            }
          },
          "required": ["source"]
        }
      },
      "required": ["slot", "contract"]
    },
    "route": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "when": {
          "type": "string"
        },
        "read": {
          "$ref": "#/$defs/path"
        },
        "before-writing": {
          "$ref": "#/$defs/path"
        }
      },
      "required": ["id", "when", "read"]
    },
    "hook": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "event": {
          "enum": ["session-start", "pre-tool", "prompt-submit", "stop"]
        },
        "agents": {
          "type": "array",
          "minItems": 0,
          "items": {
            "enum": ["claude-code", "copilot-cli", "codex"]
          }
        },
        "command": {
          "type": "string"
        },
        "matcher": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": ["id", "event", "command"]
    },
    "variable": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "detect": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "env"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": ["kind", "name"]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "dir-exists"
                },
                "candidates": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^~/(?=[\\s\\S])(?!/)(?:(?:\\.|[^/\\\\:\\u0000]*[^/\\\\:\\u0000. ])?/)*(?:\\.|[^/\\\\:\\u0000]*[^/\\\\:\\u0000. ])?$",
                    "description": "CM-7, M-18: ~/ and then a path that passes the M-03 rules."
                  }
                }
              },
              "required": ["kind", "candidates"]
            }
          ]
        }
      },
      "required": ["name", "description"]
    },
    "provides": {
      "type": "object",
      "properties": {
        "contracts": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/contractName"
          }
        },
        "index": {
          "$ref": "#/$defs/path"
        },
        "exports": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "skills": {
          "$ref": "#/$defs/path"
        },
        "agents": {
          "$ref": "#/$defs/path"
        },
        "services": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/service"
          }
        }
      },
      "required": []
    }
  }
}
