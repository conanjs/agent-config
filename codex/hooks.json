{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.copilot/tracker/tracker-hook.sh\" --hook codex --stdin",
            "commandWindows": "node \"%USERPROFILE%\\.copilot\\tracker\\tracker.mjs\" --hook codex --stdin",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.copilot/hooks/turn-tokens/turn-tokens-hook.sh\" --hook codex",
            "commandWindows": "node \"%USERPROFILE%\\.copilot\\hooks\\turn-tokens\\turn-tokens.mjs\" --hook codex",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.copilot/frameworks/agentic-sdlc/tools/workflow-graph/workflow-graph-hook.sh\" hook guard --agent codex",
            "commandWindows": "node \"%USERPROFILE%\\.copilot\\frameworks\\agentic-sdlc\\tools\\workflow-graph\\src\\main.ts\" hook guard --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.copilot/frameworks/agentic-sdlc/tools/workflow-graph/workflow-graph-hook.sh\" hook approve --agent codex",
            "commandWindows": "node \"%USERPROFILE%\\.copilot\\frameworks\\agentic-sdlc\\tools\\workflow-graph\\src\\main.ts\" hook approve --agent codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
