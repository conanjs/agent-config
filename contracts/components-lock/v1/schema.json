{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/conanjs/agent-config/contracts/components-lock/v1/schema.json",
  "title": "components-lock/v1",
  "description": "What the installer resolved and linked: components.lock in the home, JSON on disk with sorted keys.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "components-lock/v1"
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/lockEntry"
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      }
    }
  },
  "required": ["schema", "components"],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "M-03: lowercase letters, digits and hyphens, 1 to 64 characters, starting with a letter or digit."
    },
    "contractName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*/v[1-9][0-9]*$",
      "description": "A contract id such as component/v1."
    },
    "refName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.][A-Za-z0-9_./+@-]*$",
      "description": "M-05: a branch or tag name that cannot start with a dash."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "localPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$",
      "description": "A path on V's machine: any text without NUL."
    },
    "gitSource": {
      "type": "object",
      "properties": {
        "type": {
          "const": "git"
        },
        "url": {
          "type": "string",
          "anyOf": [
            {
              "pattern": "^https://(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|(?!(?:[a-z0-9.-]*\\.)?(?:[0-9]+|0x[0-9a-f]*)(?::|/|$))[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?)(?!:443(?:/|$))(?::(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._~!$&'()*+,;=:@|-]*)*$"
            },
            {
              "pattern": "^ssh://(?:[A-Za-z0-9._-]+@)?[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._~!$&'()*+,;=:@|-]*)*$"
            }
          ],
          "description": "CL-3, CL-4, M-05, M-07: https or ssh, no password, no user-info on https, no query or fragment."
        },
        "ref": {
          "$ref": "#/$defs/refName"
        }
      },
      "required": ["type", "url", "ref"]
    },
    "pathSource": {
      "type": "object",
      "properties": {
        "type": {
          "const": "path"
        },
        "path": {
          "$ref": "#/$defs/localPath"
        }
      },
      "required": ["type", "path"]
    },
    "archiveSource": {
      "type": "object",
      "properties": {
        "type": {
          "const": "archive"
        },
        "url": {
          "type": "string",
          "pattern": "^https://(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|(?!(?:[a-z0-9.-]*\\.)?(?:[0-9]+|0x[0-9a-f]*)(?::|/|$))[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?)(?!:443(?:/|$))(?::(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._~!$&'()*+,;=:@|-]*)*$",
          "description": "https only; archive sources are recognised and refused in this release (AC-3.7)."
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": ["type", "url", "sha256"]
    },
    "source": {
      "oneOf": [
        {
          "$ref": "#/$defs/gitSource"
        },
        {
          "$ref": "#/$defs/pathSource"
        },
        {
          "$ref": "#/$defs/archiveSource"
        }
      ]
    },
    "lockEntry": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "resolved": {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "tag": {
              "$ref": "#/$defs/refName"
            },
            "live": {
              "type": "boolean"
            },
            "path": {
              "$ref": "#/$defs/localPath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [],
          "anyOf": [
            {
              "properties": {
                "commit": {}
              },
              "required": ["commit"]
            },
            {
              "properties": {
                "live": {
                  "const": true
                },
                "path": {}
              },
              "required": ["live", "path"]
            },
            {
              "properties": {
                "sha256": {}
              },
              "required": ["sha256"]
            }
          ]
        },
        "manifest": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string"
            },
            "slot": {
              "$ref": "#/$defs/id"
            },
            "contracts": {
              "type": "array",
              "minItems": 0,
              "items": {
                "$ref": "#/$defs/contractName"
              }
            }
          },
          "required": ["version", "slot", "contracts"]
        },
        "build": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "source_sha": {
                  "type": "string"
                },
                "build": {
                  "type": "integer",
                  "minimum": 1
                },
                "adapters": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "required": ["source_sha", "build", "adapters"]
            }
          ]
        },
        "store_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        }
      },
      "required": ["source", "resolved"]
    }
  }
}
