{
  "permissions": {
    "allow": []
  },
  "model": "sonnet",
  "effortLevel": "high",
  "agentPushNotifEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.copilot/tracker/tracker-hook.sh\" --hook claude \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 15,
            "statusMessage": "Reading TRACKER.md"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.copilot/hooks/turn-tokens/turn-tokens-hook.sh\" --hook claude",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.copilot/frameworks/agentic-sdlc/tools/workflow-graph/workflow-graph-hook.sh\" hook guard --agent claude-code",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.copilot/frameworks/agentic-sdlc/tools/workflow-graph/workflow-graph-hook.sh\" hook approve --agent claude-code",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.copilot/hooks/turn-tokens/turn-tokens-hook.sh\" --statusline"
  }
}
