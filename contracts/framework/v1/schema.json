{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/conanjs/agent-config/contracts/framework/v1/schema.json",
  "title": "framework/v1: a framework component",
  "type": "object",
  "properties": {
    "schema": {
      "const": "framework/v1"
    },
    "project-links": {
      "type": "array",
      "items": {
        "enum": [".claude", ".agents"]
      },
      "minItems": 1
    },
    "validators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "command": {
            "type": "string"
          },
          "arguments": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "required": ["id", "command"]
      }
    }
  },
  "required": ["schema"],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])$)[a-z0-9][a-z0-9-]{0,63}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*(?:^|/)(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][nN][iI][nN]\\$|[cC][oO][nN][oO][uU][tT]\\$|[cC][lL][oO][cC][kK]\\$|[cC][oO][mM][0-9\\u00b9\\u00b2\\u00b3]|[lL][pP][tT][0-9\\u00b9\\u00b2\\u00b3])(?: *\\.[^/]*)?(?:/|$))(?!/)(?:\\.|[^/\\\\:\\u0000]*[^/\\\\:\\u0000. ])?(?:/(?:\\.|[^/\\\\:\\u0000]*[^/\\\\:\\u0000. ])?)*$"
    }
  }
}
