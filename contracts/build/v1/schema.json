{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/conanjs/agent-config/contracts/build/v1/schema.json",
  "title": "build/v1: the always-loaded baseline file",
  "type": "object",
  "properties": {
    "schema": {
      "const": "build/v1"
    },
    "agents": {
      "type": "object",
      "properties": {
        "claude-code": {
          "type": "object",
          "properties": {
            "characters": {
              "type": "integer",
              "minimum": 0
            },
            "tokens_estimate": {
              "type": "integer",
              "minimum": 0
            },
            "agent_home_lines": {
              "type": "integer",
              "minimum": 0
            },
            "method": {
              "type": "string",
              "pattern": "\\S"
            },
            "tool_version": {
              "type": "string",
              "pattern": "\\S"
            },
            "node_version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "skill_list_characters": {
              "type": "integer",
              "minimum": 0
            },
            "skill_list_sdlc_characters": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "characters",
            "tokens_estimate",
            "agent_home_lines",
            "method",
            "tool_version",
            "node_version",
            "date",
            "commit",
            "skill_list_characters",
            "skill_list_sdlc_characters"
          ]
        },
        "copilot-cli": {
          "type": "object",
          "properties": {
            "characters": {
              "type": "integer",
              "minimum": 0
            },
            "tokens_estimate": {
              "type": "integer",
              "minimum": 0
            },
            "agent_home_lines": {
              "type": "integer",
              "minimum": 0
            },
            "method": {
              "type": "string",
              "pattern": "\\S"
            },
            "tool_version": {
              "type": "string",
              "pattern": "\\S"
            },
            "node_version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "characters",
            "tokens_estimate",
            "agent_home_lines",
            "method",
            "tool_version",
            "node_version",
            "date",
            "commit"
          ]
        },
        "codex": {
          "type": "object",
          "properties": {
            "characters": {
              "type": "integer",
              "minimum": 0
            },
            "tokens_estimate": {
              "type": "integer",
              "minimum": 0
            },
            "agent_home_lines": {
              "type": "integer",
              "minimum": 0
            },
            "method": {
              "type": "string",
              "pattern": "\\S"
            },
            "tool_version": {
              "type": "string",
              "pattern": "\\S"
            },
            "node_version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "characters",
            "tokens_estimate",
            "agent_home_lines",
            "method",
            "tool_version",
            "node_version",
            "date",
            "commit"
          ]
        }
      },
      "required": ["claude-code", "copilot-cli", "codex"]
    }
  },
  "required": ["schema", "agents"]
}
