{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/conanjs/agent-config/contracts/hooks/v1/schema.json",
  "title": "hooks/v1: the hooks of a component",
  "type": "object",
  "properties": {
    "schema": {
      "const": "hooks/v1"
    },
    "hooks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hook"
      },
      "minItems": 1
    }
  },
  "required": ["schema", "hooks"],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?:\\.|[^/\\\\:\\u0000]*[^/\\\\:\\u0000. ])?(?:/(?:\\.|[^/\\\\:\\u0000]*[^/\\\\:\\u0000. ])?)*$"
    },
    "hook": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "event": {
          "enum": ["session-start", "pre-tool", "prompt-submit", "stop"]
        },
        "agents": {
          "type": "array",
          "items": {
            "enum": ["claude-code", "copilot-cli", "codex"]
          }
        },
        "command": {
          "type": "string"
        },
        "matcher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["id", "event", "command"]
    }
  }
}
