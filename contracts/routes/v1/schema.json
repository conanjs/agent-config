{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/conanjs/agent-config/contracts/routes/v1/schema.json",
  "title": "routes/v1: the routes of a component",
  "type": "object",
  "properties": {
    "schema": {
      "const": "routes/v1"
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      },
      "minItems": 1
    }
  },
  "required": ["schema", "routes"],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?:\\.|[^/\\\\:\\u0000]*[^/\\\\:\\u0000. ])?(?:/(?:\\.|[^/\\\\:\\u0000]*[^/\\\\:\\u0000. ])?)*$"
    },
    "route": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "when": {
          "type": "string"
        },
        "read": {
          "$ref": "#/$defs/path"
        },
        "before-writing": {
          "$ref": "#/$defs/path"
        }
      },
      "required": ["id", "when", "read"]
    }
  }
}
