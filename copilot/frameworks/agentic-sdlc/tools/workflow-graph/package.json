{
  "name": "@agent-config/workflow-graph",
  "version": "0.1.0",
  "private": true,
  "description": "Enforces the agentic-sdlc workflow graph: graph checks, run ledger, guard and approval hooks for Claude Code, Copilot CLI and Codex (specs/019). Runs under Node's type stripping; no runtime dependencies.",
  "type": "module",
  "engines": {
    "node": ">=24.12 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "format:check": "prettier --check src"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-tsdoc": "0.5.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "imports": {
    "#src/*": "./src/*"
  }
}
