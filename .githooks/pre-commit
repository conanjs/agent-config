#!/usr/bin/env bash
# Runs the doc validators and their tests when a commit touches knowledge, procedures, their schemas/tools or tests/.
# Enable once per clone: git config core.hooksPath .githooks   (bypass in an emergency: git commit --no-verify)
# Note: validates the working tree, so unstaged edits to the same files are checked too.
root="$(git rev-parse --show-toplevel)"
if git diff --cached --name-only | grep -qE '^(copilot/(knowledge|procedures|frameworks/(knowledge|agentic-sdlc|agent-foundry))|tests)/|^(package\.json|pnpm-lock\.yaml|cucumber\.mjs)$'; then
  "$root/scripts/check-docs.sh" || { echo "pre-commit: doc validation failed (see above)." >&2; exit 1; }
fi
