{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/conanjs/agent-config/contracts/framework/v1/schema.json",
  "title": "framework/v1: a framework component",
  "type": "object",
  "properties": {
    "schema": {
      "const": "framework/v1"
    },
    "project-links": {
      "type": "array",
      "items": {
        "enum": [".claude", ".agents"]
      },
      "minItems": 1
    },
    "validators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "command": {
            "type": "string"
          },
          "arguments": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "required": ["id", "command"]
      }
    }
  },
  "required": ["schema"],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?:\\.|[^/\\\\:\\u0000]*[^/\\\\:\\u0000. ])?(?:/(?:\\.|[^/\\\\:\\u0000]*[^/\\\\:\\u0000. ])?)*$"
    }
  }
}
